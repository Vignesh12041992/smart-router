{
  "name": "laya-smart-router",
  "version": "1.0.0",
  "description": "Pick the best local Ollama model for any prompt, using the Laya System-1 decision model",
  "license": "MIT",
  "homepage": "https://github.com/Vignesh12041992/smart-router#readme",
  "bugs": {
    "url": "https://github.com/Vignesh12041992/smart-router/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vignesh12041992/smart-router.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "smart-router": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "llm",
    "router",
    "ollama",
    "laya",
    "cli"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "npm run build && node dist/cli.js serve",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "optionalDependencies": {
    "@receptron/laya": "^0.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
